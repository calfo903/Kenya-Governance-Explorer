# ── Database (SQLite for local / Postgres for production) ──────────
# Local default:
DATABASE_URL="file:./db/custom.db"
# Production example:
# DATABASE_URL="postgresql://user:password@host:5432/kenya_governance"

# ── Auth (custom JWT — required) ──────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-long-random-string-here

# ── AI ─────────────────────────────────────────────────────────────
# Primary: OpenRouter (Gemini 2.5 Flash). Get key at https://openrouter.ai/keys
# Falls back to z-ai-web-dev-sdk if empty.
OPENROUTER_API_KEY=

# ── Admin access ──────────────────────────────────────────────────
# Email address of the admin user (must match the registered account).
# Required to access PATCH /api/db/tips/*/status and /api/db/stories/*/status.
ADMIN_EMAIL=

# Token for the Ombudsman decryption panel (GET /api/db/tips/:id).
# Generate with: openssl rand -hex 32
# If unset, the endpoint is locked out entirely.
ADMIN_DECRYPTION_TOKEN=

# ── Optional ───────────────────────────────────────────────────────
# NODE_ENV=development
