generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// County Governance Database Schema
// Kenya Governance Explorer — 2022-2027 Term
// ═══════════════════════════════════════════════════════════════════

model County {
  id             String   @id @unique // e.g. "001"
  name           String   // e.g. "Mombasa"
  code           String   @unique
  region         String
  capital        String
  population     Int
  areaSqKm       Float
  constituencies Int
  wards          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  governor      Governor?
  leadership    CountyLeadership?
  auditRecords  CountyAuditRecord[]
  budgetRecords CountyBudgetRecord[]
  projects      ProjectRecord[]
}

model Governor {
  id         String   @id @default(uuid())
  fullName   String
  party      String
  coalition  String?
  termStart  DateTime
  termEnd    DateTime
  countyCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  county County @relation(fields: [countyCode], references: [id])
}

model CountyLeadership {
  id              String  @id @default(uuid())
  countyCode      String  @unique

  deputyGovernor  String?
  senator         String?
  womanRep        String?
  assemblySpeaker String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  county County @relation(fields: [countyCode], references: [id])
  cecms  CountyCECM[]
  mcas   CountyMCA[]
}

model CountyCECM {
  id           String  @id @default(uuid())
  leadershipId String
  portfolio    String
  fullName     String
  qualification String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leadership CountyLeadership @relation(fields: [leadershipId], references: [id])
}

model CountyMCA {
  id           String  @id @default(uuid())
  leadershipId String
  constituency String
  ward         String
  fullName     String
  party        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leadership CountyLeadership @relation(fields: [leadershipId], references: [id])
}

model CountyAuditRecord {
  id               String  @id @default(uuid())
  countyCode       String
  financialYear    String
  executiveOpinion String?
  assemblyOpinion  String?
  keyFindings      String // JSON array stored as text for SQLite compatibility
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  county County @relation(fields: [countyCode], references: [id])

  @@index([countyCode])
  @@index([financialYear])
}

model CountyBudgetRecord {
  id                    String  @id @default(uuid())
  countyCode            String
  financialYear         String
  totalBudget           Float
  developmentBudget     Float
  recurrentBudget       Float
  devAbsorptionRate     Float
  recurrentAbsorptionRate Float
  ownSourceRevenue      Float
  pendingBills          Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  county County @relation(fields: [countyCode], references: [id])

  @@index([countyCode])
  @@index([financialYear])
}

model ProjectRecord {
  id               String  @id
  name             String
  countyCode       String
  category         String
  status           String  @default("planning")
  budgetAllocated   Float
  budgetSpent       Float   @default(0)
  auditOpinion     String?
  riskScore        Int     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  county County @relation(fields: [countyCode], references: [id])
}

model WhistleblowerReport {
  id             String   @id @default(uuid())
  category       String
  countyCode     String?
  encrypted      Boolean  @default(false)
  status         String   @default("pending")
  createdAt      DateTime @default(now())
}

model CitizenStory {
  id          String   @id @default(uuid())
  countyName  String
  sector      String
  title       String
  experience  String
  rating      Int
  anonymous   Boolean  @default(true)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([countyName])
  @@index([sector])
  @@index([status])
  @@index([createdAt])
}

model CitizenTip {
  id          String   @id @default(uuid())
  countyName  String
  category    String
  description String
  anonymous   Boolean  @default(true)
  status      String   @default("pending")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([countyName])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}
